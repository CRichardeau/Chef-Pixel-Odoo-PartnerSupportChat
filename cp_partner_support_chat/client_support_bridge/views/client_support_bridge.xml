<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_client_support_bridge_form" model="ir.ui.view">
        <field name="name">client.support.bridge.form</field>
        <field name="model">client.support.bridge</field>
        <field name="arch" type="xml">
            <form string="Client Support Bridge">
                <header>
                    <button name="test_client_connection" string="Test Connection" type="object" 
                            class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Client Name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_url" readonly="state != 'draft'"/>
                            <field name="client_db" readonly="state != 'draft'"/>
                            <!-- <field name="client_user" readonly="1"/> -->
                            <field name="client_company" readonly="1"/>
                            <field name="client_channel" invisible="1"/>
                        </group>
                        <group>
                            <field name="livechat_channel_id" readonly="state != 'draft'" required="True"/>
                            <!-- <field name="mail_channel_id" readonly="1"/> -->
                            <field name="token"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Client Users Configuration">
                            <field name="authorized_client_ids">
                                <list editable="bottom" create="0" edit="0" delete="0">
                                    <field name="bridge_id" column_invisible="1"/>
                                    <!-- <field name="client_db"/> -->
                                    <field name="client_user" width="25%"/>
                                    <field name="channel_id" width="50%"/>
                                    <button name="open_discuss_channel" type="object" icon="fa-comments" 
                                            class="btn btn-link" title="Open Chat" width="5%"/>
                                    <field name="date" width="10%"/>
                                    <field name="state" width="10%" widget="badge"
                                        decoration-success="state == 'active'"
                                        decoration-danger="state == 'close'"/>
                                    <field name="partner_session" column_invisible="1"/>
                                    <field name="client_channel" column_invisible="1"/>
                                    <!-- <field name="api_key"/> -->
                                    <!-- <field name="is_active"/> -->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_client_support_bridge_tree" model="ir.ui.view">
        <field name="name">client.support.bridge.tree</field>
        <field name="model">client.support.bridge</field>
        <field name="arch" type="xml">
            <list string="Client Support Bridge">
                <field name="name"/>
                <field name="client_db"/>
                <field name="livechat_channel_id"/>
            </list>
        </field>
    </record>

    <record id="action_client_support_bridge" model="ir.actions.act_window">
        <field name="name">Client Support Bridge</field>
        <field name="res_model">client.support.bridge</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new client support bridge
            </p>
            <p>
                Configure connections between client systems and partner support.
            </p>
        </field>
    </record>

    <!-- <menuitem id="menu_client_support_bridge_root" 
        name="Support Bridge"/> -->

    <menuitem id="menu_client_support_bridge" 
              name="Client Bridge"
              action="action_client_support_bridge"/>
</odoo>
